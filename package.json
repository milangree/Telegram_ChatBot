    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "vite": "^8.0.8",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
